# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — required for encrypted API key storage (iter-05)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL = production origin (e.g. https://your-app.vercel.app)
#   Redirect URLs = https://your-app.vercel.app/** and http://localhost:3000/**

# Encrypt user LLM API keys at rest (32 bytes, base64 — generate with: openssl rand -base64 32)
LLM_ENCRYPTION_KEY=your-base64-32-byte-key

# Legacy env provider (optional — platform default uses BAILIAN_API_KEY directly)
LLM_PROVIDER=bailian

# Optional — LLM request timeout in ms (default 120000; /api/chat maxDuration is 130s)
LLM_TIMEOUT_MS=120000
# Optional — abort if no stream chunk within this window (default 60000)
# LLM_CHUNK_TIMEOUT_MS=60000

# Upstash Redis (iter-06 — resumable chat streams; optional in local dev)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# Optional Redis protocol URL (auto-derived from REST URL when omitted)
UPSTASH_REDIS_URL=rediss://default:your-token@your-host.upstash.io:6379

# E2E (optional — iter-04 authenticated flows)
E2E_TEST_EMAIL=your-test-user@example.com
E2E_TEST_PASSWORD=your-test-password

# SiliconFlow (OpenAI-compatible)
SILICONFLOW_API_KEY=your-siliconflow-api-key
# Optional — defaults to https://api.siliconflow.cn/v1
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=your-deepseek-api-key
# Optional — defaults to https://api.deepseek.com/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI
OPENAI_API_KEY=your-openai-api-key
# Optional — defaults to https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Alibaba Bailian / DashScope (OpenAI-compatible) — platform default model key
BAILIAN_API_KEY=your-bailian-api-key
# Optional — defaults to https://dashscope.aliyuncs.com/compatible-mode/v1 (cn-beijing)
# Singapore: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# US: https://dashscope-us.aliyuncs.com/compatible-mode/v1
# BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
