# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# LLM provider: siliconflow | nvidia (default: siliconflow)
LLM_PROVIDER=nvidia

# Optional — override the provider default model
# NVIDIA: deepseek-ai/deepseek-v4-flash | deepseek-ai/deepseek-v4-pro
# SiliconFlow: Qwen/Qwen2.5-7B-Instruct
# LLM_MODEL=deepseek-ai/deepseek-v4-flash

# SiliconFlow (OpenAI-compatible)
SILICONFLOW_API_KEY=your-siliconflow-api-key
# Optional — defaults to https://api.siliconflow.cn/v1
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# NVIDIA NIM (OpenAI-compatible)
NVIDIA_API_KEY=your-nvidia-api-key
# Optional — defaults to https://integrate.api.nvidia.com/v1
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
