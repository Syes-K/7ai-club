# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# LLM provider: siliconflow | nvidia | bailian (default: siliconflow)
# Aliases: dashscope, aliyun → bailian
LLM_PROVIDER=bailian

# Optional — override the provider default model
# NVIDIA: deepseek-ai/deepseek-v4-flash | deepseek-ai/deepseek-v4-pro
# SiliconFlow: Qwen/Qwen2.5-7B-Instruct
# Bailian: qwen3.6-plus
# LLM_MODEL=qwen3.6-plus

# Optional — LLM request timeout in ms (default 120000; /api/chat maxDuration is 130s)
LLM_TIMEOUT_MS=120000
# Optional — abort if no stream chunk within this window (default 60000)
# LLM_CHUNK_TIMEOUT_MS=60000

# SiliconFlow (OpenAI-compatible)
SILICONFLOW_API_KEY=your-siliconflow-api-key
# Optional — defaults to https://api.siliconflow.cn/v1
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# NVIDIA NIM (OpenAI-compatible)
NVIDIA_API_KEY=your-nvidia-api-key
# Optional — defaults to https://integrate.api.nvidia.com/v1
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Alibaba Bailian / DashScope (OpenAI-compatible)
BAILIAN_API_KEY=your-bailian-api-key
# Optional — defaults to https://dashscope.aliyuncs.com/compatible-mode/v1 (cn-beijing)
# Singapore: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# US: https://dashscope-us.aliyuncs.com/compatible-mode/v1
# BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
