{
  "name": "7ai-club",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "test:e2e:ui": "playwright test --ui",
    "test:ci": "pnpm lint && pnpm build && vitest run && playwright test",
    "skills:install": "npx skills experimental_install -y && bash scripts/patch-superpowers-gating.sh",
    "skills:update": "npx skills update -p -y && npx skills update -g -y && bash scripts/patch-superpowers-gating.sh",
    "skills:lock": "bash scripts/sync-skills-lock.sh"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.71",
    "@ai-sdk/openai-compatible": "^2.0.50",
    "@ai-sdk/react": "^3.0.207",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@upstash/redis": "^1.38.0",
    "ai": "^6.0.205",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "doc-to-md-rag": "^1.0.1",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "redis": "^6.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resumable-stream": "^2.2.12",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
